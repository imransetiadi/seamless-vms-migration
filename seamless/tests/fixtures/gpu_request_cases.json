{
 "_comment": "A flavor's GPU requests as Nova reads its extra specs (SDD §22.2), shared by seamless/tests/test_gpu.py (planning/gpu.gpu_requests) and dashboard/src/lib/gpu.test.ts (the mock's port of it, PR #64 review). Each case: extra_specs and a declared_profile, when the flavor's provider declares one -> the requests, in order, each with the fields that differ from a GpuDevice's defaults.",
 "cases": [
  {
   "why": "a bare VGPU request with its required and forbidden traits; a preferred trait and another spec are no part of it",
   "extra_specs": {
    "resources:VGPU": "1",
    "trait:CUSTOM_NVIDIA_A100_4C": "required",
    "trait:CUSTOM_NVIDIA_OLD": "forbidden",
    "trait:CUSTOM_ANY": "preferred",
    "hw:cpu_policy": "dedicated"
   },
   "requests": [
    {
     "kind": "vgpu",
     "resource_class": "VGPU",
     "traits": [
      "CUSTOM_NVIDIA_A100_4C"
     ],
     "forbidden_traits": [
      "CUSTOM_NVIDIA_OLD"
     ]
    }
   ]
  },
  {
   "why": "each numbered group with its own traits, in suffix order, the GPU provider's own (same_provider); the unnumbered group's traits belong to none",
   "extra_specs": {
    "resources_GPU-b:VGPU": "2",
    "trait_GPU-b:CUSTOM_B": "required",
    "trait_GPU-b:CUSTOM_A": "required",
    "resources1:VGPU": "1",
    "trait1:CUSTOM_ONE": "required",
    "trait:CUSTOM_ROOT": "required",
    "resources:VCPU": "4"
   },
   "requests": [
    {
     "kind": "vgpu",
     "resource_class": "VGPU",
     "traits": [
      "CUSTOM_ONE"
     ],
     "same_provider": true
    },
    {
     "kind": "vgpu",
     "resource_class": "VGPU",
     "count": 2,
     "traits": [
      "CUSTOM_A",
      "CUSTOM_B"
     ],
     "same_provider": true
    }
   ]
  },
  {
   "why": "the unnumbered group first, then the numbered ones",
   "extra_specs": {
    "resources2:VGPU": "1",
    "resources:VGPU": "1",
    "trait:CUSTOM_X": "forbidden"
   },
   "requests": [
    {
     "kind": "vgpu",
     "resource_class": "VGPU",
     "forbidden_traits": [
