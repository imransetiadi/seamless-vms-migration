# syntax=docker/dockerfile:1.7
# Seamless Migrate control plane (SDD §17).
#
# Build context is the REPOSITORY ROOT:
#   podman build --ignorefile seamless/.containerignore -f seamless/Containerfile -t seamless:0.1.0 .
#   docker build -f seamless/Containerfile -t seamless:0.1.0 .   # uses Containerfile.dockerignore
#
# The built dashboard (dashboard/dist) is copied when present; build it first to include it, or
# point DASHBOARD_DIST elsewhere: --build-arg DASHBOARD_DIST=path/to/dist

# Pinned by digest (Security.md §12): the manifest list of ubi9/python-311:latest as of 2026-10-08.
# Dependabot (docker, /seamless) proposes digest bumps; `dnf update` below still applies errata
# published after the pin at build time.
ARG BASE_IMAGE=registry.access.redhat.com/ubi9/python-311:latest@sha256:a0bdb55576fc5b8d6704279307817828ef027e1065533ceba133fe9516003a6c
FROM ${BASE_IMAGE}

ARG DASHBOARD_DIST=dashboard/dist
ARG ANSIBLE_CORE_VERSION=">=2.16,<2.19"
# The VMware migration kit version comes from requirements.yml (pinned: the executor's variable
# contract with the kit is checked against that version, Security.md §9.2).

LABEL org.opencontainers.image.title="seamless-migrate" \
      org.opencontainers.image.description="Seamless Migrate control plane: VM migration to RHOSO 18.0" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.licenses="Apache-2.0"

USER 0

# Security.md §12: apply the base image's pending errata at build time (the UBI tag lags
# its errata), then Node 22 for the npx-launched Jev MCP server and ssh/rsync for Ansible.
RUN dnf -y update --setopt=install_weak_deps=False \
 && dnf -y module enable nodejs:22 \
 && dnf -y install --setopt=install_weak_deps=False nodejs npm openssh-clients rsync \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# Control plane with the OpenStack, VMware and Jev extras, plus ansible-core.
COPY seamless/pyproject.toml seamless/README.md /opt/seamless/src/seamless/
COPY seamless/src /opt/seamless/src/seamless/src
# pip/setuptools/urllib3/msgpack are upgraded past their advisories (image scan, QASuite §10).
# hadolint ignore=DL3013
RUN python3 -m pip install --no-cache-dir --upgrade pip "setuptools>=78.1.1" \
 && python3 -m pip install --no-cache-dir "/opt/seamless/src/seamless[openstack,vmware,jev]" \
        "ansible-core${ANSIBLE_CORE_VERSION}" "urllib3>=2.8.0" "msgpack>=1.2.1"

# The os-migrate collection from this repository and the VMware migration kit.
COPY galaxy.yml README.md LICENSE CHANGELOG.rst requirements.yml /opt/seamless/collection/
COPY meta /opt/seamless/collection/meta
COPY plugins /opt/seamless/collection/plugins
COPY roles /opt/seamless/collection/roles
COPY playbooks /opt/seamless/collection/playbooks
COPY scripts/vendor-openstack-cloud.sh /opt/seamless/vendor-openstack-cloud.sh
# The roles call openstack.cloud modules as os_migrate.os_migrate.<module> (server_action,
# server_info, network, …): the checkout vendors them through a git submodule, the image from
# the pinned Galaxy release (SDD §17.1).
ARG OS_CLOUD_VERSION=2.6.0
# openstack.cloud stays installed: the vendored modules extend its doc fragment
# (openstack.cloud.openstack), which ansible-doc and ansible-lint resolve from there.
RUN ansible-galaxy collection install "openstack.cloud:${OS_CLOUD_VERSION}" \
        -p /usr/share/ansible/collections \
 && bash /opt/seamless/vendor-openstack-cloud.sh /opt/seamless/collection \
        /usr/share/ansible/collections/ansible_collections/openstack/cloud/plugins
RUN ansible-galaxy collection build /opt/seamless/collection --output-path /tmp/collection \
 && ansible-galaxy collection install /tmp/collection/*.tar.gz \
        -p /usr/share/ansible/collections --force \
 && ansible-galaxy collection install -r /opt/seamless/collection/requirements.yml \
        -p /usr/share/ansible/collections \
 && rm -rf /tmp/collection /root/.ansible

# pip is a build-time tool only: its vendored urllib3/msgpack/setuptools copies lag their
# advisories (image scan, QASuite S-19), so it leaves the runtime image.
# hadolint ignore=DL3013
RUN python3 -m pip uninstall -y pip \
 && rm -rf /opt/app-root/lib/python3.11/site-packages/pip* \
           /opt/app-root/lib64/python3.11/site-packages/pip* \
           /opt/app-root/bin/pip /opt/app-root/bin/pip3 /opt/app-root/bin/pip3.11

# Dashboard build, only when it exists in the build context.
RUN --mount=type=bind,source=.,target=/ctx \
    mkdir -p /opt/seamless/dashboard \
 && if [ -f "/ctx/${DASHBOARD_DIST}/index.html" ]; then \
        cp -r "/ctx/${DASHBOARD_DIST}/." /opt/seamless/dashboard/; \
    else echo "dashboard build not found at ${DASHBOARD_DIST}; serving the API only"; fi

# /var/lib/seamless is the default data dir; /data is the mount point the Compose stack uses
# (a fresh named volume takes the ownership of its mount point, so the non-root user owns it).
RUN mkdir -p /var/lib/seamless /data \
 && chown -R 1001:0 /var/lib/seamless /data /opt/seamless \
 && chmod -R g=u /var/lib/seamless /data /opt/seamless

ENV HOME=/var/lib/seamless \
    SEAMLESS_DATA_DIR=/var/lib/seamless \
    SEAMLESS_HOST=0.0.0.0 \
    SEAMLESS_PORT=8080 \
    SEAMLESS_COLLECTION_ROOT=/usr/share/ansible/collections/ansible_collections/os_migrate/os_migrate \
    SEAMLESS_DASHBOARD_DIR=/opt/seamless/dashboard \
    SEAMLESS_LOG_JSON=true \
    ANSIBLE_HOME=/var/lib/seamless/.ansible \
    ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    PYTHONUNBUFFERED=1

USER 1001
WORKDIR /var/lib/seamless
EXPOSE 8080
VOLUME ["/var/lib/seamless"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python3", "-c", "import urllib.request,sys; r = urllib.request.urlopen('http://127.0.0.1:8080/api/v1/health', timeout=4); sys.exit(0 if r.status == 200 else 1)"]

ENTRYPOINT ["seamless"]
CMD ["serve"]
