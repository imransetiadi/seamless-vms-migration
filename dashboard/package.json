{
  "name": "seamless-migrate-dashboard",
  "version": "0.5.0-rc.5",
  "private": true,
  "description": "Seamless Migrate operator dashboard (SDD §16)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_SEAMLESS_MOCK=1 vite",
    "build": "npm run typecheck:app && vite build && node scripts/check-bundle.mjs",
    "build:mock": "VITE_SEAMLESS_MOCK=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck:app && tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/fira-sans": "5.3.0",
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7",
    "recharts": "3.11.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
